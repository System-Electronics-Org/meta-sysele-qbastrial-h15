software =
{
	version = "1.12.0"
	description = "QBAstrial H15 system update: rootfs and fitImage";
	hardware-compatibility: [ "1.0"];
	embedded-script = "
-- set default parameters
vars = {
    FILESYSTEM_DEVICE = '@@SWUPDATE_DEFAULT_FILESYSTEM_DEVICE@@',
    FIRMWARE_DEVICE = '@@SWUPDATE_DEFAULT_FIRMWARE_DEVICE@@',
    FW_ENV_DEVICE = '@@SWUPDATE_DEFAULT_FW_ENV_DEVICE@@'
}

-- override parameters with config file
local cfg = io.open('/tmp/swupdate.cfg', 'r')
if cfg then
	for line in cfg:lines() do
		local sep = line:find('=')
		if sep then
			vars[line:sub(1, sep - 1)] = line:sub(sep + 1)
		end
    end
    cfg:close()
end

-- formatting function to replace '${key}' with the parameter from vars[key]
function format(str)
	return (str:gsub('%${(.-)}', function(key)
		return vars[key]
	end))
end

-- hook functions for using templated fields
function format_device(elem)
	elem.device = format(elem.device)
	return true, elem
end

function format_data(elem)
	elem.data = format(elem.data)
	return true, elem
end

";
	stable = {
		copy-a: {
			images: (
				{
					filename = "@@HAILO_TARGET@@-@@MACHINE@@.ext4.gz";
					sha256 = "$swupdate_get_sha256(@@HAILO_TARGET@@-@@MACHINE@@.ext4.gz)";
					device = "/dev/${FILESYSTEM_DEVICE}p2";
					hook = "format_device";
					installed-directly = true;
					compressed = "zlib";
				},
			);
			files: (
				{
					filename = "fitImage";
					sha256 = "$swupdate_get_sha256(fitImage)";
					path = "/fitImage";
					device = "/dev/${FILESYSTEM_DEVICE}p1";
					hook = "format_device";
					filesystem = "vfat";
				},
			);
			scripts: (
				{
					filename = "resize_fs.sh";
					sha256 = "$swupdate_get_sha256(resize_fs.sh)";
					type = "postinstall";
					data = "/dev/${FILESYSTEM_DEVICE}p2";
					hook = "format_data";
				},
			);
		}
	}
}
